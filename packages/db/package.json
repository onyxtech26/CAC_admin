    "test": "echo \"(schema is exercised by @cac/core integration tests)\" && exit 0",
    "bootstrap": "tsx src/bootstrap.ts",
    "console": "tsx src/console.ts",
    "backup": "tsx src/backup-cli.ts",
    "perf": "tsx src/perf.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.2.17",
    "drizzle-orm": "0.38.4",
    "pg": "8.13.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@cac/core": "workspace:*",
    "@types/node": "22.19.17",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.30.2",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.8"
  }
